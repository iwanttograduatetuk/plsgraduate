# Edge Agent 환경변수 예시
# 복사 후 .env로 이름 변경하여 사용

# 지점/기계 식별
SITE_ID=site-A
MACHINE_ID=cnc-001

# FastAPI
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_TOPIC_ANOMALY_EVENTS=anomaly-events
KAFKA_TOPIC_SENSOR_TELEMETRY=sensor-telemetry
KAFKA_TELEMETRY_INTERVAL_SEC=30

# 모델
MODEL_DIR=./models
MODEL_VERSION=v1.0.0
# 임계값 오버라이드 (설정 시 info.json의 3sigma 임계값 대신 사용)
# MODEL_THRESHOLD_OVERRIDE_COOLANT=0.02
# MODEL_THRESHOLD_OVERRIDE_HYDRAULICS=0.035
# MODEL_THRESHOLD_OVERRIDE_PROBE=0.03

# 데이터 수집
DATA_REPLAY_MODE=true
REPLAY_AUTO_START=true
DATA_REPLAY_CSV_DIR=../../real_op
DATA_REPLAY_SPEED_FACTOR=10.0
DATA_RESAMPLE_INTERVAL=1.0
DATA_WINDOW_SIZE=30
DATA_PROCESSED_DATA_DIR=../../anomaly_detection/processed_data_v2

#매핑 경로
DATA_PROCESSED_DATA_DIR=C:\Users\o\Desktop\graduate\plsgraduate\predictive-maintenance-system\anomaly_detection\processed_data_v2

# 데모 플레이리스트 모드
# 시퀀스: 정상10초 → coolant10초 → 정상5초 → hydraulics10초 → 정상5초 → probe10초 → 랜덤폴트10초 → 반복
DATA_DEMO_MODE=true
DATA_DEMO_FIRST_NORMAL_SEC=10
DATA_DEMO_INTER_NORMAL_SEC=5
DATA_DEMO_FAULT_SEC=10
DATA_DIG_TWIN_DIR=C:\Users\o\Desktop\graduate\plsgraduate\dataset_causRCA\dig_twin
