        "content": "<div style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:16px;font-family:sans-serif;\"><div style=\"font-size:14px;color:#aaa;margin-bottom:4px;\">기계 ID: <strong style=\"color:#fff\">cnc-001</strong></div><div style=\"display:flex;gap:16px;\"><button onclick=\"sendCmd(this,'STOP')\" style=\"padding:14px 32px;font-size:16px;font-weight:bold;border:none;border-radius:6px;background:#e53e3e;color:#fff;cursor:pointer;\">⏹ STOP</button><button onclick=\"sendCmd(this,'RESUME')\" style=\"padding:14px 32px;font-size:16px;font-weight:bold;border:none;border-radius:6px;background:#38a169;color:#fff;cursor:pointer;\">▶ RESUME</button></div><div id=\"r\" style=\"margin-top:8px;font-size:13px;color:#68d391;min-height:20px;\"></div></div><script>function sendCmd(btn,cmd){var r=document.getElementById(\"r\");btn.disabled=true;r.textContent=cmd+\" 전송 중...\";var b=new URLSearchParams();b.append(\"command\",cmd);b.append(\"reason\",\"Grafana\");fetch(\"http:///api/machines/cnc-001/command\",{method:\"POST\",mode:\"no-cors\",body:b}).then(function(){r.textContent=\"✅ \"+cmd+\" 전송 완료\";btn.disabled=false;}).catch(function(e){r.textContent=\"❌ \"+e;btn.disabled=false;});}</script>"
